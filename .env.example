# ─────────────────────────────────────────────────────────────
# NEXORA · variables de entorno
# Copiá este archivo como .env.local y completá los valores.
# Nunca subas .env.local al repositorio.
# ─────────────────────────────────────────────────────────────

# Supabase (Project Settings → API). Estas dos son públicas por diseño:
# la seguridad depende de Row Level Security, no de ocultar la clave.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# URL pública de la app (links de confirmación y recuperación de contraseña)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SOLO SERVIDOR — usada únicamente por scripts/seed-demo.mjs. No lleva NEXT_PUBLIC_.
# No hace falta cargarla en Vercel: el seed se corre desde tu máquina.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Demo pública ("Explorar demo"). SOLO SERVIDOR.
DEMO_USER_EMAIL=demo@nexora.app
DEMO_USER_PASSWORD=elegi-una-clave-larga

# NEXORA AI. SOLO SERVIDOR. Sin AI_API_KEY y AI_MODEL el asistente avisa
# que no está conectado (nunca simula respuestas).
#   AI_PROVIDER=anthropic → API de Anthropic (Messages)
#   AI_PROVIDER=openai    → cualquier API compatible con Chat Completions
AI_PROVIDER=anthropic
AI_API_KEY=
# Identificador del modelo tal como lo publica tu proveedor (p. ej. claude-haiku-5-5).
AI_MODEL=
# Opcional: URL base alternativa (gateways o proveedores compatibles con OpenAI).
# AI_BASE_URL=
#
# Ejemplo con el plan gratuito de Google Gemini (clave en aistudio.google.com):
#   AI_PROVIDER=openai
#   AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   AI_MODEL=gemini-flash-lite-latest
